# =============================================================================
# Not tracked in this repo. Everything below stays on disk locally — it is
# simply out of scope for a repo focused on the experiment engine and analysis.
# =============================================================================

# Manuscript: LaTeX source, figures, ACL style files, submission bundle, build dir
paper/

# Interactive explainer — published separately as a hosted artifact
demo/

# Design logs and the shelved study's write-ups. README.md is the only tracked doc.
*.md
!README.md

# authority_override/ is a shelved earlier study. Only the shared API client and
# model registry it provides are dependencies of the MatchMarket engine, so only
# those are tracked.
authority_override/*
!authority_override/__init__.py
!authority_override/client.py
!authority_override/models.py

# =============================================================================
# Standard ignores
# =============================================================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# API-budget bookkeeping written at run time (call/token counters, not results)
logs/

# Editor / tool backups
*.bak

# OS
.DS_Store
Thumbs.db
